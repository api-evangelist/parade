      "item": [
        {
          "id": "202f5183-23f3-4611-a745-e7831417e863",
          "name": "Search for loads here",
          "request": {
            "name": "Search for loads here",
            "description": {
              "content": "Search for available loads here. We currently do not support filtering based on city or radius, only state.\n\nUsers are recommended to query and paginate to receive all available loads. Use page and limit query string parameters and the returned x-total-count header to paginate.\n\nAny load that is no longer returned by this API should be considered unavailable and removed from third party loadboards.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "syndication",
                "loads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "src_date",
                  "value": "<string>",
                  "description": "pickup date of load"
                },
                {
                  "disabled": false,
                  "key": "src_date__gte",
                  "value": "<string>",
                  "description": "earliest pickup date of load"
                },
                {
                  "disabled": false,
                  "key": "src_date__lte",
                  "value": "<string>",
                  "description": "latest pickup date of load"
                },
                {
                  "disabled": false,
                  "key": "dst_date",
                  "value": "<string>",
                  "description": "dropoff date of load"
                },
                {
                  "disabled": false,
                  "key": "dst_date__gte",
                  "value": "<string>",
                  "description": "earliest dropoff date of load"
                },
                {
                  "disabled": false,
                  "key": "dst_date__lte",
                  "value": "<string>",
                  "description": "latest dropoff date of load"
                },
                {
                  "disabled": false,
                  "key": "company_external_key",
                  "value": "<string>",
                  "description": "filters on company specific"
                },
                {
                  "disabled": false,
                  "key": "equipment",
                  "value": "<string>",
                  "description": "Equipment of load. Valid filter values are \"Van\", \"Flatbed\", or \"Reefer\".\n\nFilter for multiple equipment types with comma separated values.\n"
                },
                {
                  "disabled": false,
                  "key": "src_state",
                  "value": "<string>",
                  "description": "pickup state of load"
                },
                {
                  "disabled": false,
                  "key": "dst_state",
                  "value": "<string>",
                  "description": "destination state of load"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Pagination: Page number to retrieve. Defaults to 1.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Pagination: Number of loads to retrieve per page. Defaults to 2000.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
