        {
          "id": "9bae62fa-5c98-4251-a160-8177521315ae",
          "name": "Post your bookings here",
          "request": {
            "name": "Post your bookings here",
            "description": {
              "content": "Post your bookings here. \n\nEvery time a Book Now happens, one of 3 things may happen:\n\n- If we are API integrated back to the broker TMS (80%+ of the time), the book endpoint will ping the broker TMS \n  when your request is made and return a response code immediately, with a 201 if the booking was successful. \n\n- If the broker is not API integrated, we either need to run an asynchronous RPA or have the broker manually complete the booking, which can take up to 30 minutes.\n  If you want to set up a webhook to receive booking confirmation events via a webhook, please take a look at the Booking Confirmation Webhook documentation.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ls",
                "syndication",
                "book"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrier_dot_number\": \"<string>\",\n  \"carrier_email\": \"<string>\",\n  \"carrier_name\": \"<string>\",\n  \"carrier_phone_number\": \"<string>\",\n  \"company_external_key\": \"<string>\",\n  \"load_reference_id\": \"<string>\",\n  \"offer_external_key\": \"<string>\",\n  \"carrier_mc_number\": \"<string>\",\n  \"offer_rate\": \"<number>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
